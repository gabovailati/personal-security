# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot
# 1. Create a bot via @BotFather on Telegram, copy the token here.
# 2. Send any message to the bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Folder where the Reolink FTP daemon writes recordings (any nested layout works).
WATCH_DIR=/srv/ftp/reolink

# Where to keep the "already processed" SQLite DB.
STATE_DB=./reolink_analyzer.db

# How often to scan WATCH_DIR for new files.
POLL_SECONDS=10

# Files newer than this many seconds are skipped (still being written).
MIN_FILE_AGE_SECONDS=5

# On startup, skip thumbnails older than this many hours (avoids backlog spam).
SKIP_OLDER_THAN_HOURS=1

# After detecting a thumbnail, wait up to this many seconds for the matching
# .mp4 to finish uploading before falling back to thumbnail-only analysis.
VIDEO_WAIT_SECONDS=60

# How many frames to sample from the video for the deeper pass.
VIDEO_FRAMES=6

# Clips uploaded without a .jpg snapshot are analysed from a frame of the video,
# once the clip has been idle this many seconds (a late snapshot still wins).
ORPHAN_VIDEO_GRACE_SECONDS=60

# A snapshot-less clip starting within this many seconds of an earlier clip from
# the same camera is treated as part of that event and not alerted again (0 = off).
EVENT_GAP_SECONDS=120

# Models. Defaults to Opus 4.7 for best quality; swap for Sonnet 4.6 or Haiku
# 4.5 if you want cheaper/faster classification.
#   THUMB_MODEL=claude-haiku-4-5
#   VIDEO_MODEL=claude-sonnet-4-6
THUMB_MODEL=claude-opus-4-7
VIDEO_MODEL=claude-opus-4-7

# When to send Telegram alerts: "always" or "interesting".
# - always: notify for every motion event, even empty scenes.
# - interesting: only notify when the thumbnail pass flags it as interesting.
ALERT_ON=interesting
